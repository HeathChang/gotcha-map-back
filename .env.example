# Server
PORT=8060
NODE_ENV=development

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=gachamap

# JWT (min 32 chars, required)
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# 하위 호환: 기존 코드 호환을 위한 필드
JWT_EXPIRES_IN=15m

# Cookie (auth.md - httpOnly + Secure + SameSite)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Password hashing (auth.md: >=12 in production)
BCRYPT_ROUNDS=12

# Observability
SERVICE_NAME=gachamap-api

# Mail (SMTP) — 비밀번호 재설정 메일 발송. 미설정 시 발송 no-op(부팅은 정상).
# 운영에서는 반드시 설정. SendGrid/SES/Gmail 등 SMTP 지원 서비스면 됨.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password-or-api-key
# MAIL_FROM=가챠맵 <no-reply@yourdomain.com>

# Server
PORT=8080
NODE_ENV=development

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=gachamap

# JWT (min 32 chars, required)
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Password hashing (auth.md: >=12 in production)
BCRYPT_ROUNDS=12

# Observability
SERVICE_NAME=gachamap-api

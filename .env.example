# Server
PORT=8080
NODE_ENV=development

# MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=gachamap

# JWT (min 32 chars, required)
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=14
# 하위 호환: 기존 코드 호환을 위한 필드
JWT_EXPIRES_IN=15m

# Cookie (auth.md - httpOnly + Secure + SameSite)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# CORS — comma-separated origins
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Password hashing (auth.md: >=12 in production)
BCRYPT_ROUNDS=12

# Observability
SERVICE_NAME=gachamap-api
